generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String

  role      Role     @default(ADMIN)

  isActive Boolean @default(true)

  failedLoginCount Int @default(0)

  failedLoginStartedAt DateTime?

  lockedUntil DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id          String @id @default(cuid())

  title       String
  slug        String @unique
  description String

  location    String
  price       BigInt

  status      PropertyStatus

  featured    Boolean @default(false)

  bedrooms     Int?
  bathrooms    Int?
  landSize     Int?
  buildingSize Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images PropertyImage[]
}

model PropertyImage {
  id String @id @default(cuid())

  imageUrl String

  propertyId String

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())

  name      String
  email     String
  phone     String
  message   String

  ipAddress String?

  createdAt DateTime @default(now())
}

enum Role {
  ADMIN
  SUPERADMIN
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  BOOKED
}
